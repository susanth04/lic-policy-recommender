# ==============================================================================
# LIC Policy Recommender - Environment Configuration Template
# ==============================================================================

# --- LLM Layer (Part A) ---
ENABLE_LLM=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_TIMEOUT=3.0
LLM_MAX_TOKENS=512
LLM_DAILY_CAP=100

# --- Database & Memory (Part B) ---
DATABASE_URL=sqlite:///lic_recommender.db
TOKEN_SECRET=lic-secure-token-secret-key-change-in-production
TOKEN_EXPIRY_DAYS=365
HISTORY_RETENTION_DAYS=90
STALE_DAYS=180

# --- Serving & Security ---
LIC_CORS_ORIGINS=*
